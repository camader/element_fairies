[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/victory_screen.gd" id="1_script"]

[node name="VictoryScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.15, 0.1, 0.25, 1)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -200.0
offset_right = 300.0
offset_bottom = 200.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 30

[node name="TitleLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 56
theme_override_colors/font_color = Color(1, 0.85, 0.3, 1)
text = "Victory!"
horizontal_alignment = 1

[node name="MessageLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "The Fairy Princess has been rescued!
All fairies are united once more!"
horizontal_alignment = 1
autowrap_mode = 2

[node name="Spacer" type="Control" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 30)

[node name="TitleButton" type="Button" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(250, 50)
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 24
text = "Return to Title"

[connection signal="pressed" from="VBox/TitleButton" to="." method="_on_title_button_pressed"]
