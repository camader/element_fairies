[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/fairy_rescue_cutscene.gd" id="1_script"]

[node name="FairyRescue" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.1, 0.08, 0.2, 1)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -200.0
offset_right = 300.0
offset_bottom = 200.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 25

[node name="TitleLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 48
theme_override_colors/font_color = Color(1, 0.85, 0.3, 1)
text = "Fairy Rescued!"
horizontal_alignment = 1

[node name="FairyLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Earth Fairy"
horizontal_alignment = 1

[node name="MessageLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "You freed the fairy from the darkness!"
horizontal_alignment = 1
autowrap_mode = 2

[node name="Spacer" type="Control" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 30)

[node name="ContinueButton" type="Button" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(250, 50)
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 24
text = "Continue"

[connection signal="pressed" from="VBox/ContinueButton" to="." method="_on_continue_button_pressed"]
